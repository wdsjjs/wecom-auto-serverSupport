#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
AGENT_DIR="$ROOT_DIR/wecom-gui"
AGENT_SCRIPT="$AGENT_DIR/scripts/wecom-agent"
ENV_FILE="${WECOM_AGENT_ENV:-$AGENT_DIR/.env.local}"
APP_NAME="企业微信"
QUIT_WECOM=0

usage() {
  cat <<'EOF'
Usage: ./stop [options]

Stops the WeCom AI customer-service services started by ./run.

Options:
  --quit-wecom   Also quit the Enterprise WeChat app.
  -h, --help     Show this help.
EOF
}

die() {
  echo "ERROR: $*" >&2
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --quit-wecom)
      QUIT_WECOM=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
  shift
done

[[ -x "$AGENT_SCRIPT" ]] || die "missing executable: $AGENT_SCRIPT"

if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi

APP_NAME="${WECOM_GUI_APP_NAME:-$APP_NAME}"

kill_leftovers() {
  local pattern="$1"
  local pids

  pids="$(pgrep -f "$pattern" 2>/dev/null || true)"
  [[ -n "$pids" ]] || return 0

  printf '%s\n' "$pids" | xargs kill 2>/dev/null || true
  sleep 0.5

  pids="$(pgrep -f "$pattern" 2>/dev/null || true)"
  if [[ -n "$pids" ]]; then
    printf '%s\n' "$pids" | xargs kill -9 2>/dev/null || true
  fi
}

cd "$AGENT_DIR"

echo "Stopping WeCom customer-service services..."
"$AGENT_SCRIPT" stop
"$AGENT_SCRIPT" review-stop
"$AGENT_SCRIPT" sidebar-stop

kill_leftovers 'cli_anything\.wecom_gui agent'
kill_leftovers 'cli_anything\.wecom_gui review'
kill_leftovers 'cli_anything\.wecom_gui sidebar'

if [[ "$QUIT_WECOM" == "1" ]]; then
  if osascript -e "tell application \"System Events\" to exists process \"$APP_NAME\"" 2>/dev/null | grep -qi true; then
    osascript -e "tell application \"$APP_NAME\" to quit" >/dev/null 2>&1 || true
    echo "quit: $APP_NAME"
  else
    echo "not running: $APP_NAME"
  fi
fi

echo
"$AGENT_SCRIPT" status
"$AGENT_SCRIPT" review-status

echo
echo "Stopped."
