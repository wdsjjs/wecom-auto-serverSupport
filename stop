#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
AGENT_DIR="$ROOT_DIR/wecom-gui"
ENV_FILE="$AGENT_DIR/.env.local"
APP_NAME="企业微信"
QUIT_WECOM=0

usage() {
  cat <<'EOF'
Usage: ./stop [--quit-wecom]

Stops the background WeCom AI customer-service agent.

Options:
  --quit-wecom   Also quit the Enterprise WeChat app after stopping the agent.
  -h, --help     Show this help.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --quit-wecom)
      QUIT_WECOM=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi

APP_NAME="${WECOM_GUI_APP_NAME:-$APP_NAME}"

if [[ ! -x "$AGENT_DIR/scripts/wecom-agent" ]]; then
  echo "ERROR: missing executable: $AGENT_DIR/scripts/wecom-agent" >&2
  exit 1
fi

cd "$AGENT_DIR"

./scripts/wecom-agent stop
./scripts/wecom-agent review-stop
./scripts/wecom-agent sidebar-stop

pkill -f 'cli_anything\.wecom_gui agent' 2>/dev/null || true
pkill -f 'cli_anything\.wecom_gui review' 2>/dev/null || true
pkill -f 'cli_anything\.wecom_gui sidebar' 2>/dev/null || true
pkill -f 'SCREEN -dmS wecom-agent' 2>/dev/null || true
pkill -f 'SCREEN -dmS wecom-review' 2>/dev/null || true
pkill -f 'SCREEN -dmS wecom-sidebar-8111' 2>/dev/null || true

if [[ "$QUIT_WECOM" == "1" ]]; then
  if osascript -e "tell application \"System Events\" to exists process \"$APP_NAME\"" 2>/dev/null | grep -qi true; then
    osascript -e "tell application \"$APP_NAME\" to quit" >/dev/null 2>&1 || true
    echo "quit: $APP_NAME"
  else
    echo "not running: $APP_NAME"
  fi
fi

echo
./scripts/wecom-agent status
echo
echo "Stopped."
