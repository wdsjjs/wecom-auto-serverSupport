#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
AGENT_DIR="$ROOT_DIR/wecom-gui"
AGENT_SCRIPT="$AGENT_DIR/scripts/wecom-agent"
ENV_FILE="${WECOM_AGENT_ENV:-$AGENT_DIR/.env.local}"

MODE_OVERRIDE=""
RESTART=0
REVIEW_SETTING="auto"

usage() {
  cat <<'EOF'
Usage: ./run [options]

Starts the WeCom AI customer-service agent. In review mode, it also starts the
LAN review page.

Options:
  --mode MODE    Override WECOM_AGENT_MODE for this run: review, auto, dry-run.
  --review       Start the review page regardless of mode.
  --no-review    Do not start the review page.
  --restart      Stop agent/review/sidebar services before starting.
  -h, --help     Show this help.
EOF
}

die() {
  echo "ERROR: $*" >&2
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --mode)
      shift
      [[ $# -gt 0 ]] || die "--mode requires a value"
      MODE_OVERRIDE="$1"
      ;;
    --mode=*)
      MODE_OVERRIDE="${1#*=}"
      ;;
    --review)
      REVIEW_SETTING="on"
      ;;
    --no-review)
      REVIEW_SETTING="off"
      ;;
    --restart)
      RESTART=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
  shift
done

[[ -x "$AGENT_SCRIPT" ]] || die "missing executable: $AGENT_SCRIPT"

if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi

if [[ -n "$MODE_OVERRIDE" ]]; then
  export WECOM_AGENT_MODE="$MODE_OVERRIDE"
fi

if [[ -z "${SDKROOT:-}" && -d "/Library/Developer/CommandLineTools/SDKs/MacOSX15.5.sdk" ]]; then
  export SDKROOT="/Library/Developer/CommandLineTools/SDKs/MacOSX15.5.sdk"
fi

MODE="${WECOM_AGENT_MODE:-review}"
START_REVIEW=0
case "$REVIEW_SETTING" in
  auto)
    [[ "$MODE" == "review" ]] && START_REVIEW=1
    ;;
  on)
    START_REVIEW=1
    ;;
  off)
    START_REVIEW=0
    ;;
esac

cd "$AGENT_DIR"

if [[ "$RESTART" == "1" ]]; then
  "$AGENT_SCRIPT" stop
  "$AGENT_SCRIPT" review-stop
  "$AGENT_SCRIPT" sidebar-stop
fi

echo "Starting WeCom customer-service agent..."
"$AGENT_SCRIPT" start

if [[ "$START_REVIEW" == "1" ]]; then
  echo
  echo "Starting review page..."
  "$AGENT_SCRIPT" review-start
fi

echo
"$AGENT_SCRIPT" status
if [[ "$START_REVIEW" == "1" ]]; then
  "$AGENT_SCRIPT" review-status
fi

echo
echo "Logs:"
echo "  $AGENT_DIR/.codex-run/wecom-agent.log"
if [[ "$START_REVIEW" == "1" ]]; then
  echo "  $AGENT_DIR/.codex-run/wecom-review.log"
fi
