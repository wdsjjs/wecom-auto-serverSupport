# Copy to .env.local on the receiver machine. Do not commit .env.local.

# Required for UDA drafting.
WECOM_GUI_UDA_API_KEY=replace-with-real-key
WECOM_GUI_UDA_URL=https://wework-unified-api.uda.cn/chat/single_question

# App name on macOS. Chinese WeCom is usually 企业微信.
WECOM_GUI_APP_NAME=企业微信

# Optional: set these on another machine if npm scripts cannot find Python/deps.
# WECOM_GUI_PYTHON=/absolute/path/to/python3
# WECOM_GUI_PYTHONPATH=/absolute/path/to/site-packages-or-deps-dir

# Default behavior for the AI customer-service agent.
WECOM_GUI_AI_PROVIDER=uda
WECOM_AGENT_MODE=review
WECOM_GUI_WELCOME_MESSAGE={WELCOME_MESSAGE}
WECOM_GUI_REQUIRED_TAG=@微信
WECOM_GUI_REQUIRE_WECHAT_TAG=1
WECOM_GUI_REQUIRE_UNREAD=1
WECOM_GUI_ALLOW_UNTAGGED=0
WECOM_GUI_INCLUDE_EXTERNAL_GROUPS=0
WECOM_GUI_NORMALIZE_FULLSCREEN=1
WECOM_GUI_WINDOW_MODE=fullscreen
WECOM_GUI_COORD_MODE=adaptive

# Optional agent tuning. Keep scan pages at 1 for the safest visible-only scan;
# increase to 2-3 to experimentally scroll the sidebar and find lower unread rows.
WECOM_AGENT_MAX_DRAFTS=10
WECOM_AGENT_TEXT_WORKERS=7
WECOM_AGENT_IMAGE_WORKERS=3
WECOM_AGENT_INBOX_LIMIT=8
WECOM_AGENT_SCAN_PAGES=1
WECOM_AGENT_SCROLL_TICKS=6
WECOM_AGENT_DEEP_SCAN_INTERVAL=30
WECOM_GUI_CAPTURE_IMAGES=1
WECOM_GUI_CAPTURE_IMAGE_DIR=.codex-run/wecom-images

# Central WeCom desktop-channel edge client. The device token is local-only and
# grants this Mac access only to its bound WeCom account. Never commit it.
# WECOM_CHANNEL_BASE_URL=https://kefu-api.example.com
# WECOM_CHANNEL_DEVICE_ID=mac-cs-01
# WECOM_CHANNEL_DEVICE_TOKEN=replace-with-device-token
# WECOM_CHANNEL_ACCOUNT_ID=wecom-account-01
# WECOM_CHANNEL_TIMEOUT_SECONDS=10
# WECOM_CHANNEL_HEARTBEAT_PATH=/api/wecom-channel/edge/heartbeat
# WECOM_CHANNEL_INBOUND_PATH=/api/wecom-channel/edge/inbound-events
# WECOM_CHANNEL_PULL_PATH=/api/wecom-channel/edge/commands/pull
# WECOM_CHANNEL_COMMAND_MEDIA_PATH=/api/wecom-channel/edge/commands/{command_id}/media/{media_id}
# WECOM_CHANNEL_RESULT_PATH=/api/wecom-channel/edge/commands/{command_id}/result

# Optional LAN review page.
WECOM_REVIEW_HOST=0.0.0.0
WECOM_REVIEW_PORT=8122

# Optional: use Codex CLI for drafting instead of UDA.
# WECOM_GUI_AI_PROVIDER=codex
# WECOM_GUI_CODEX_COMMAND=/opt/homebrew/bin/codex
# WECOM_GUI_CODEX_MODEL=gpt-5
# WECOM_GUI_CODEX_TIMEOUT=120
# WECOM_GUI_PI_TEXT_MODEL=deepseek-v4-flash
# WECOM_GUI_PI_IMAGE_MODEL=qwen3.6-flash

# Optional: let the 8111 WeCom sidebar enrich external_userid bindings through
# the official WeCom APIs. Corp ID, agent ID, and app secret are enough to sign
# JS-SDK calls and read the current sidebar external_userid. External contact
# secret is only needed when enriching that UID into official customer details.
# WECOM_CORP_ID=replace-with-real-corp-id
# WECOM_AGENT_ID=replace-with-real-agent-id
# WECOM_APP_SECRET=replace-with-real-agent-secret
# WEWORK_CORP_ID=replace-with-real-corp-id
# WEWORK_AGENT_ID=replace-with-real-agent-id
# WEWORK_AGENT_SECRET=replace-with-real-agent-secret
# WECOM_EXTERNAL_CONTACT_CORP_ID=replace-with-real-corp-id
# WECOM_EXTERNAL_CONTACT_SECRET=replace-with-real-external-contact-secret
